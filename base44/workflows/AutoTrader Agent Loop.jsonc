{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autotrader_agent_loop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_positions": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPositions",
            "args": {}
          },
          "then": "scan_market",
          "x-base44": {
            "title": "Manage open positions",
            "description": "Take-profit, stop-loss, trailing"
          }
        }
      },
      {
        "scan_market": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanMarket",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan for entries",
            "description": "Gate pipeline + open positions"
          }
        }
      }
    ]
  },
  "name": "AutoTrader Agent Loop",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes: resolve open positions against fresh prices, then scan the market for new entries."
}