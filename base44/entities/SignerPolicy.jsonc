{
  "name": "SignerPolicy",
  "type": "object",
  "properties": {
    "execution_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for real signing. Default false \u2014 the guard refuses everything while off."
    },
    "allowed_execution_tokens": {
      "type": "array",
      "description": "Explicit mint allowlist. Empty means refuse all execution.",
      "items": {
        "type": "string"
      }
    },
    "max_trade_usd": {
      "type": "number",
      "default": 0,
      "description": "Per-trade ceiling enforced by the signer itself. Zero or unset refuses all execution."
    },
    "require_capital_cap": {
      "type": "boolean",
      "default": true,
      "description": "When true an unconfigured capital cap is refused instead of skipped."
    },
    "signer_mode": {
      "type": "string",
      "enum": [
        "disabled",
        "devnet_transfer_test",
        "mainnet_swap"
      ],
      "default": "disabled",
      "description": "mainnet_swap is refused outright \u2014 unbuilt."
    },
    "human_approval_over_usd": {
      "type": "number",
      "default": 0,
      "description": "Trades above this size require a human approval flag. Zero disables the threshold."
    }
  },
  "required": []
}