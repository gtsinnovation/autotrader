{
  "name": "ExecutionAudit",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "requested_usd": {
      "type": "number"
    },
    "allowed": {
      "type": "boolean",
      "default": false
    },
    "reason": {
      "type": "string"
    },
    "signer_mode": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "description": "Every guard check re-derived at request time",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "token_address",
    "allowed"
  ]
}