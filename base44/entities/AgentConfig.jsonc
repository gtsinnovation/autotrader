{
  "name": "AgentConfig",
  "type": "object",
  "properties": {
    "kill_switch": {
      "type": "boolean",
      "default": false,
      "description": "Master stop. When true the agent takes no new positions."
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "default": "paper"
    },
    "mev_protection": {
      "type": "boolean",
      "default": true,
      "description": "Protected submission required. Live mode is blocked when false."
    },
    "capital_cap_usd": {
      "type": "number",
      "default": 1000
    },
    "max_position_usd": {
      "type": "number",
      "default": 50
    },
    "max_open_positions": {
      "type": "number",
      "default": 5
    },
    "min_liquidity_usd": {
      "type": "number",
      "default": 25000
    },
    "min_buyers_1h": {
      "type": "number",
      "default": 40
    },
    "min_capital_per_participant_usd": {
      "type": "number",
      "default": 15,
      "description": "Floor on average USD per participation event. Fails closed when unmeasured."
    },
    "max_structure_risk": {
      "type": "number",
      "default": 55
    },
    "max_slippage_bps": {
      "type": "number",
      "default": 600
    },
    "atr_stop_multiple": {
      "type": "number",
      "default": 1.8
    },
    "take_profit_multiple": {
      "type": "number",
      "default": 2
    },
    "trailing_stop_pct": {
      "type": "number",
      "default": 25
    },
    "partial_exit_pct": {
      "type": "number",
      "default": 50
    },
    "min_age_minutes": {
      "type": "number",
      "default": 15
    },
    "max_age_hours": {
      "type": "number",
      "default": 72
    }
  },
  "required": []
}