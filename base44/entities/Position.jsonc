{
  "name": "Position",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "pair_address": {
      "type": "string"
    },
    "size_usd": {
      "type": "number"
    },
    "entry_price": {
      "type": "number"
    },
    "last_price": {
      "type": "number"
    },
    "peak_price": {
      "type": "number"
    },
    "take_profit_price": {
      "type": "number"
    },
    "stop_loss_price": {
      "type": "number"
    },
    "trailing_stop_percent": {
      "type": "number"
    },
    "entry_score": {
      "type": "number"
    },
    "assumed_slippage_percent": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "exit_price": {
      "type": "number"
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "TAKE_PROFIT",
        "STOP_LOSS",
        "TRAILING_STOP",
        "MANUAL"
      ]
    },
    "gross_pnl_percent": {
      "type": "number"
    },
    "cost_percent": {
      "type": "number"
    },
    "net_pnl_percent": {
      "type": "number"
    },
    "net_pnl_usd": {
      "type": "number"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token_address",
    "entry_price"
  ]
}