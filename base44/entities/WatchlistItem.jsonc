{
  "name": "WatchlistItem",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual"
    },
    "liquidity_usd": {
      "type": "number"
    },
    "conviction": {
      "type": "number"
    },
    "structure_risk": {
      "type": "number"
    }
  },
  "required": [
    "token_address"
  ]
}