{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_price_usd": {
      "type": "number"
    },
    "last_liquidity_usd": {
      "type": "number"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token_address"
  ]
}