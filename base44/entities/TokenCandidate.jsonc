{
  "name": "TokenCandidate",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Discovery source, e.g. dexscreener_profiles, dexscreener_boosts"
    },
    "dex": {
      "type": "string"
    },
    "pair_address": {
      "type": "string"
    },
    "price_usd": {
      "type": "number"
    },
    "liquidity_usd": {
      "type": "number"
    },
    "fdv_usd": {
      "type": "number"
    },
    "volume_24h_usd": {
      "type": "number"
    },
    "volume_1h_usd": {
      "type": "number"
    },
    "buys_1h": {
      "type": "number"
    },
    "sells_1h": {
      "type": "number"
    },
    "price_change_5m": {
      "type": "number"
    },
    "price_change_1h": {
      "type": "number"
    },
    "age_minutes": {
      "type": "number"
    },
    "atr_proxy_pct": {
      "type": "number",
      "description": "Volatility proxy used for ATR-scaled stops"
    },
    "structure_risk": {
      "type": "number",
      "description": "0-100 composite manipulation/insider risk"
    },
    "slippage_ceiling_bps": {
      "type": "number"
    },
    "conviction": {
      "type": "number",
      "description": "0-100 composite entry conviction"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reject_reason": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "description": "Per-gate results of the evaluation pipeline",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "measured": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "token_address",
    "decision"
  ]
}