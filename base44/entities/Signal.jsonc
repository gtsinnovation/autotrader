{
  "name": "Signal",
  "type": "object",
  "properties": {
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "launchpad": {
      "type": "string"
    },
    "price_usd": {
      "type": "number"
    },
    "liquidity_usd": {
      "type": "number"
    },
    "fdv_usd": {
      "type": "number"
    },
    "volume_h1_usd": {
      "type": "number"
    },
    "txns_h1": {
      "type": "number"
    },
    "buys_h1": {
      "type": "number"
    },
    "sells_h1": {
      "type": "number"
    },
    "traders_h1": {
      "type": "number"
    },
    "net_buyers_h1": {
      "type": "number"
    },
    "buy_volume_share": {
      "type": "number"
    },
    "organic_volume_share": {
      "type": "number"
    },
    "organic_score": {
      "type": "number"
    },
    "organic_score_label": {
      "type": "string"
    },
    "holder_count": {
      "type": "number"
    },
    "top_holders_percent": {
      "type": "number"
    },
    "dev_balance_percent": {
      "type": "number"
    },
    "mint_authority_disabled": {
      "type": "boolean"
    },
    "freeze_authority_disabled": {
      "type": "boolean"
    },
    "price_change_m5": {
      "type": "number"
    },
    "price_change_h1": {
      "type": "number"
    },
    "liquidity_change_h1": {
      "type": "number"
    },
    "pair_age_minutes": {
      "type": "number"
    },
    "is_verified": {
      "type": "boolean"
    },
    "price_impact_percent": {
      "type": "number"
    },
    "price_impact_measured": {
      "type": "boolean",
      "default": false
    },
    "score": {
      "type": "number",
      "description": "0-100 composite conviction score."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    },
    "rejected_by": {
      "type": "string"
    },
    "reject_reason": {
      "type": "string"
    },
    "opened_position": {
      "type": "boolean",
      "default": false
    },
    "skip_reason": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "measured": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "token_address"
  ]
}